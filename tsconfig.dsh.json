{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022", "DOM"],
        "types": ["node"],
        "strict": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "allowImportingTsExtensions": false,
        "noEmit": false,
        "declaration": false,
        "sourceMap": false,
        "removeComments": false,
        "newLine": "lf"
    },
    "files": ["dsh/index.ts", "dsh/client.ts"]
}
