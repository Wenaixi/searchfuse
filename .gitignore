# build output
dist/
# dsh 的两个入口是 tsc 从 dsh/*.ts 编译出来的产物，不进仓库；
# 同目录下 search-schema.json / fetch-schema.json / spawnHidden.js 是手写源码，
# 必须照常跟踪，所以这里只点名两个文件，不整目录忽略。
dsh/index.js
dsh/client.js
# generated types
.astro/

# coverage output
coverage/

# vitest 的缓存目录：每次跑测试都会重建，不该进仓库
.vitest/

# 编辑器与工具产生的临时目录
.nx/
*.tsbuildinfo
*.log.tmp

# eval evidence artifacts (run locally, on demand)
evals/results/

