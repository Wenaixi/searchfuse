{
  "name": "@wenaixi/searchfuse",
  "version": "0.1.0",
  "description": "融合搜索插件：并发询问多个搜索引擎并用倒数排名融合结果，为原生无联网能力的模型补上网搜、X 搜索与单页抓取。开箱免费，免注册免密钥（Firecrawl 免注册通道每月 1,000 免费额度）。",
  "type": "module",
  "bin": {
    "searchfuse": "./dist/main.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && tsc -p tsconfig.dsh.json --outDir dsh",
    "build:dsh": "tsc -p tsconfig.dsh.json --outDir dsh",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.dsh.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build",
    "eval": "node evals/run.mjs",
    "docs:list": "node scripts/docs-list.js",
    "parity:check": "node scripts/parity-check.mjs",
    "parity:final": "node scripts/parity-check.mjs --final"
  },
  "files": [
    "dist",
    "docs",
    "skills/searchfuse/SKILL.md",
    "skills/searchfuse/scripts",
    "skills/searchfuse/references",
    "CHANGELOG.md",
    "SECURITY.md",
    "dsh/*.js",
    "dsh/*.d.ts",
    "dsh/*.json",
    "cordis.patch.yml",
    "omp",
    "claude",
    "!claude/tsconfig.json",
    "!dsh/*.ts.map"
  ],
  "keywords": [
    "search",
    "web-fetch",
    "cli",
    "llm",
    "agent",
    "agent-skill",
    "antigravity",
    "searchfuse",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "author": "Leon Liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/searchfuse.git"
  },
  "bugs": {
    "url": "https://github.com/Wenaixi/searchfuse/issues"
  },
  "homepage": "https://github.com/Wenaixi/searchfuse#readme",
  "engines": {
    "node": ">=22.19",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "@searxng-js/searxng": "0.1.3",
    "commander": "15.1.0",
    "undici": "8.13.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/node": "26.6.11",
    "@vitest/coverage-v8": "5.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.2"
  }
}
