{
  "name": "@wenaixi/searchfuse",
  "version": "0.1.0",
  "description": "融合搜索插件：并发询问多个搜索引擎并用倒数排名融合结果，为原生无联网能力的模型补上网搜、X 搜索与单页抓取。开箱免费，免注册免密钥（Firecrawl 免注册通道每月 1,000 免费额度）。",
  "type": "module",
  "bin": {
    "searchfuse": "./dist/main.js"
  },
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "biome lint",
    "format": "biome format --write",
    "release": "node scripts/release.mjs",
    "prepublishOnly": "pnpm build",
    "eval": "node evals/run.mjs",
    "docs:list": "node scripts/docs-list.js"
  },
  "files": [
    "dist",
    "docs",
    "skills/searchfuse/SKILL.md",
    "skills/searchfuse/scripts",
    "skills/searchfuse/references",
    "CHANGELOG.md",
    "SECURITY.md",
    "dsh",
    "cordis.patch.yml"
  ],
  "keywords": [
    "search",
    "web-fetch",
    "cli",
    "llm",
    "agent",
    "agent-skill",
    "antigravity",
    "searchfuse",
    "dsh-plugin",
    "deepseek-harness"
  ],
  "author": "Leon Liu",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wenaixi/searchfuse.git"
  },
  "bugs": {
    "url": "https://github.com/Wenaixi/searchfuse/issues"
  },
  "homepage": "https://github.com/Wenaixi/searchfuse#readme",
  "engines": {
    "node": ">=22.13",
    "dsh": ">=0.2.2-rc.1 <0.3.0-0"
  },
  "exports": {
    ".": "./dsh/index.js",
    "./dsh": "./dsh/index.js",
    "./client": "./dsh/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    }
  },
  "dependencies": {
    "commander": "^13.1.0",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "^22.19.7",
    "@vitest/coverage-v8": "3.2.4",
    "typescript": "^5.9.3",
    "vite": "^6.4.1",
    "vitest": "3.2.4"
  }
}
